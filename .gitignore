# Git ignore rules for SVARA
# AGENTS.md rule 2: Never commit data, raw audio, own recordings, or model checkpoints.

# Data (hanya audio/raw di data/ yang diignore, izinkan korpus teks data/corpus/ dan synthetic_indonesian)
data/*
!data/corpus/
!data/corpus/*.csv
!data/synthetic_indonesian/
!data/synthetic_indonesian/**
!data/synthetic_indonesian_massive/
!data/synthetic_indonesian_massive/*.csv
!data/synthetic_indonesian_massive/splits/
!data/synthetic_indonesian_massive/splits/*.csv
!data/bilingual_dataset/
!data/bilingual_dataset/splits/
!data/bilingual_dataset/splits/*.csv
!data/bilingual_massive/
!data/bilingual_massive/*.csv
!data/bilingual_massive/splits/
!data/bilingual_massive/splits/*.csv
!data/bilingual_massive/splits/*.json
*.wav
*.mp3
*.flac
*.ogg
*-inferred.onnx

# Model checkpoints and weights
*.ckpt
*.pt
*.bin
*.safetensors
models/svara.onnx
models/svara_bilingual.onnx
!models/svara_int8.onnx
!models/svara_bilingual_int8.onnx
reports/runs/**/*.ckpt
reports/runs/**/*.pt

# Node / Frontend
node_modules/
web/dist/

# Environment and secrets
.env
.env.*
!.env.example

# Python
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
